{
  "questions": [
    {
      "id": "Q1",
      "text": "orders/settlements/withdrawals 三张表的完整状态枚举取值是什么？",
      "reason": "金额计算口径依赖枚举完整性",
      "impact": "成交额/累计收益/可提现无法精确落地"
    },
    {
      "id": "Q2",
      "text": "commissionTiers 档位配置的完整结构（min_orders 与各档比例）是什么？",
      "reason": "档位计算需完整配置",
      "impact": "距下一档差值无法精确计算"
    },
    {
      "id": "Q3",
      "text": "身份证二要素核验本期是否强制？",
      "reason": "影响注册审核时效与虚假注册率",
      "impact": "注册是否调用实名核验接口不确定"
    },
    {
      "id": "Q4",
      "text": "城市枚举是否改为配置下发？",
      "reason": "影响城市列表异常处理逻辑",
      "impact": "城市列表来源不确定"
    }
  ],
  "rules": [
    {
      "id": "BR-01",
      "text": "姓名须为 2-20 个字符，允许中文/字母/空格/·，为空或纯符号或纯数字或超 20 字时输入框下方提示并阻止下一步",
      "type": "field_constraint",
      "entities": ["合伙人"],
      "fields": ["name"],
      "source": {"doc": "测试需求文档.md", "version": "V1.0", "section": "6.2.1-2", "kind": "explicit"},
      "authority": "A",
      "impact": "P1-功能",
      "priority": "P1"
    },
    {
      "id": "BR-02",
      "text": "手机号须 11 位、1 开头、第二位 3-9",
      "type": "field_constraint",
      "entities": ["合伙人"],
      "fields": ["mobile"],
      "source": {"doc": "测试需求文档.md", "version": "V1.0", "section": "6.2.1-3", "kind": "explicit"},
      "authority": "A",
      "impact": "P1-功能",
      "priority": "P1"
    },
    {
      "id": "BR-03",
      "text": "验证码 6 位、5 分钟有效，错误累计 5 次作废需重新获取",
      "type": "field_constraint",
      "entities": ["合伙人", "验证码"],
      "fields": ["sms_code"],
      "source": {"doc": "测试需求文档.md", "version": "V1.0", "section": "6.2.1-3", "kind": "explicit"},
      "authority": "A",
      "impact": "P1-功能",
      "priority": "P1"
    },
    {
      "id": "BR-04",
      "text": "验证码发送频控：同号 60 秒内不可重发、单号每日上限 10 次、单 IP 每小时 20 次、第 3 次获取起触发图形验证码",
      "type": "field_constraint",
      "entities": ["验证码"],
      "fields": ["sms_code"],
      "source": {"doc": "测试需求文档.md", "version": "V1.0", "section": "6.2.1-3", "kind": "explicit"},
      "authority": "A",
      "impact": "P0-阻断",
      "priority": "P0",
      "reasoning": "依据 6.2.1-3「单号每日上限 10 次、单 IP 每小时 20 次」等频控阈值，属防刷/资损相关硬约束"
    },
    {
      "id": "BR-05",
      "text": "城市枚举五选一（贵阳/成都/长沙/武汉/南京），必须显式选择不设默认值，未选阻止提交并提示",
      "type": "field_constraint",
      "entities": ["合伙人"],
      "fields": ["city"],
      "source": {"doc": "测试需求文档.md", "version": "V1.0", "section": "6.2.1-4", "kind": "explicit"},
      "authority": "A",
      "impact": "P2-体验",
      "priority": "P2"
    },
    {
      "id": "BR-06",
      "text": "身份证号 18 位，前 17 位数字、末位数字或 X/x，必须通过 GB 11643 校验位（ISO 7064 MOD 11-2），格式错/校验位错提示核对",
      "type": "field_constraint",
      "entities": ["合伙人"],
      "fields": ["id_card"],
      "source": {"doc": "测试需求文档.md", "version": "V1.0", "section": "6.2.1-5", "kind": "explicit"},
      "authority": "A",
      "impact": "P1-功能",
      "priority": "P1"
    },
    {
      "id": "BR-07",
      "text": "身份证已被占用时返回通用提示「该证件信息暂无法完成注册，请联系客服」，禁止提示「该身份证已注册」以防枚举",
      "type": "permission",
      "entities": ["合伙人", "身份证"],
      "fields": ["id_card"],
      "source": {"doc": "测试需求文档.md", "version": "V1.0", "section": "6.2.1-5", "kind": "explicit"},
      "authority": "A",
      "impact": "P0-阻断",
      "priority": "P0",
      "reasoning": "依据 6.2.1-5「禁止提示该身份证已注册以防枚举」，属信息安全/防枚举硬约束"
    },
    {
      "id": "BR-08",
      "text": "合作协议默认未勾选，必须用户主动勾选；未勾选按钮不提交并高亮提示",
      "type": "process",
      "entities": ["合伙人", "协议"],
      "fields": ["agreement_checked"],
      "source": {"doc": "测试需求文档.md", "version": "V1.0", "section": "6.2.1-6", "kind": "explicit"},
      "authority": "A",
      "impact": "P1-功能",
      "priority": "P1"
    },
    {
      "id": "BR-09",
      "text": "提交时记录协议版本号、勾选时间、IP、UA；协议版本与勾选版本不一致时不许提交",
      "type": "process",
      "entities": ["合伙人", "协议"],
      "fields": ["agreement_version"],
      "source": {"doc": "测试需求文档.md", "version": "V1.0", "section": "6.2.1-6", "kind": "explicit"},
      "authority": "A",
      "impact": "P1-功能",
      "priority": "P1"
    },
    {
      "id": "BR-10",
      "text": "以「手机号+身份证」为业务唯一键幂等；三次重复请求只产生一条记录、返回同一 partner_id",
      "type": "process",
      "entities": ["合伙人"],
      "fields": ["mobile", "id_card"],
      "source": {"doc": "测试需求文档.md", "version": "V1.0", "section": "6.2.1-7", "kind": "explicit"},
      "authority": "A",
      "impact": "P0-阻断",
      "priority": "P0",
      "reasoning": "依据 6.2.1-7「业务唯一键幂等，三次重复请求只产生一条记录」，属数据一致性硬约束"
    },
    {
      "id": "BR-11",
      "text": "注册成功后写入 partners（status=pending、audit_status=pending、audit_step=1）并写一条审核日志",
      "type": "process",
      "entities": ["合伙人", "审核日志"],
      "fields": ["status", "audit_status", "audit_step"],
      "source": {"doc": "测试需求文档.md", "version": "V1.0", "section": "6.2.1-7", "kind": "explicit"},
      "authority": "A",
      "impact": "P1-功能",
      "priority": "P1"
    },
    {
      "id": "BR-12",
      "text": "手机号已注册时：未通过审核引导去 P-04 看进度，已通过引导登录",
      "type": "process",
      "entities": ["合伙人"],
      "fields": ["mobile"],
      "source": {"doc": "测试需求文档.md", "version": "V1.0", "section": "6.2.1-3", "kind": "explicit"},
      "authority": "A",
      "impact": "P2-体验",
      "priority": "P2"
    },
    {
      "id": "BR-13",
      "text": "审核四步对应 audit_step=1/2/3/4，驳回时停在驳回步骤标红，任一步驳回 → rejected → 重新提交回 pending/step1",
      "type": "process",
      "entities": ["审核"],
      "fields": ["audit_step", "audit_status"],
      "source": {"doc": "测试需求文档.md", "version": "V1.0", "section": "6.1", "kind": "explicit"},
      "authority": "A",
      "impact": "P1-功能",
      "priority": "P1"
    },
    {
      "id": "BR-14",
      "text": "预计完成时间=提交时间+2个工作日（自然工作日顺延，展示到 18:00 前）；提交距今超 5 个工作日仍未流转 → 加急提示+客服入口+推送运营待办",
      "type": "process",
      "entities": ["审核"],
      "fields": ["submit_at"],
      "source": {"doc": "测试需求文档.md", "version": "V1.0", "section": "6.2.2-2", "kind": "explicit"},
      "authority": "A",
      "impact": "P1-功能",
      "priority": "P1"
    },
    {
      "id": "BR-15",
      "text": "驳回原因 reject_reason 审核员必填且 ≤200 字；为空 → 兜底文案「资料不符合要求，请联系客服确认具体原因」并告警",
      "type": "field_constraint",
      "entities": ["审核"],
      "fields": ["reject_reason"],
      "source": {"doc": "测试需求文档.md", "version": "V1.0", "section": "6.2.2-3", "kind": "explicit"},
      "authority": "A",
      "impact": "P1-功能",
      "priority": "P1"
    },
    {
      "id": "BR-16",
      "text": "重新提交后 audit_status 回 pending、audit_step 回 1、submit_at 刷新、resubmit_count+1，新增带 resubmit 标记的审核日志；重提超 3 次按钮置灰提示联系总部运营",
      "type": "process",
      "entities": ["审核"],
      "fields": ["audit_status", "audit_step", "resubmit_count"],
      "source": {"doc": "测试需求文档.md", "version": "V1.0", "section": "6.2.2-3", "kind": "explicit"},
      "authority": "A",
      "impact": "P1-功能",
      "priority": "P1"
    },
    {
      "id": "BR-17",
      "text": "审核状态轮询每 30 秒一次；连续 3 次失败停止轮询，保留最后状态并标注「数据更新于 HH:mm」",
      "type": "performance",
      "entities": ["审核"],
      "fields": ["poll_interval"],
      "source": {"doc": "测试需求文档.md", "version": "V1.0", "section": "6.2.2-4", "kind": "explicit"},
      "authority": "A",
      "impact": "P2-体验",
      "priority": "P2"
    },
    {
      "id": "BR-18",
      "text": "状态变为 approved 时展示「审核通过，已开通权限」，3 秒倒计时后自动跳 P-05",
      "type": "process",
      "entities": ["审核"],
      "fields": ["audit_status"],
      "source": {"doc": "测试需求文档.md", "version": "V1.0", "section": "6.2.2-4", "kind": "explicit"},
      "authority": "A",
      "impact": "P2-体验",
      "priority": "P2"
    },
    {
      "id": "BR-19",
      "text": "姓名脱敏展示：保留首字其余 *（如「张*」）；超长截断加省略号不换行",
      "type": "field_constraint",
      "entities": ["合伙人"],
      "fields": ["name"],
      "source": {"doc": "测试需求文档.md", "version": "V1.0", "section": "6.2.3-1", "kind": "explicit"},
      "authority": "A",
      "impact": "P2-体验",
      "priority": "P2"
    },
    {
      "id": "BR-20",
      "text": "档位取 commissionTiers 中满足 min_orders≤当月有效签单数的最高档；配置缺失或格式异常 → 兜底最低档并告警",
      "type": "field_constraint",
      "entities": ["合伙人", "档位"],
      "fields": ["commission_tier"],
      "source": {"doc": "测试需求文档.md", "version": "V1.0", "section": "6.2.3-1", "kind": "explicit"},
      "authority": "A",
      "impact": "P0-阻断",
      "priority": "P0",
      "reasoning": "依据 6.2.3-1 档位计算规则，涉及佣金分成口径，属资金相关硬约束"
    },
    {
      "id": "BR-21",
      "text": "本月签单数=当月内 partner_id 匹配且状态命中白名单（signed/in_service/completed）的订单数，时间以 orders.sign_at 为准",
      "type": "field_constraint",
      "entities": ["订单"],
      "fields": ["sign_at", "status"],
      "source": {"doc": "测试需求文档.md", "version": "V1.0", "section": "6.2.3-2", "kind": "explicit"},
      "authority": "A",
      "impact": "P0-阻断",
      "priority": "P0",
      "reasoning": "依据 6.2.3-2 签单数统计口径，涉及佣金档位计算的数据基础，属资金相关"
    },
    {
      "id": "BR-22",
      "text": "本月成交额=同一订单集合的签约金额快照 signed_amount 之和，含未完成服务订单，不因退款冲减",
      "type": "field_constraint",
      "entities": ["订单"],
      "fields": ["signed_amount"],
      "source": {"doc": "测试需求文档.md", "version": "V1.0", "section": "6.2.3-2", "kind": "explicit"},
      "authority": "A",
      "impact": "P0-阻断",
      "priority": "P0",
      "reasoning": "成交额口径含退款不冲减，涉及数据展示准确性，属资金统计"
    },
    {
      "id": "BR-23",
      "text": "累计收益=settlements 中 settled 的 partner_commission 之和 − reversed 冲正金额绝对值，pending 与 void 不计入",
      "type": "field_constraint",
      "entities": ["结算"],
      "fields": ["partner_commission"],
      "source": {"doc": "测试需求文档.md", "version": "V1.0", "section": "6.2.3-3", "kind": "explicit"},
      "authority": "A",
      "impact": "P0-阻断",
      "priority": "P0",
      "reasoning": "累计收益计算公式，直接涉及资金金额，属资损防控核心约束"
    },
    {
      "id": "BR-24",
      "text": "可提现=累计收益 − 提现中冻结（withdrawals.status in applying/paying）− 已打款（paid），结果<0 展示 0.00",
      "type": "field_constraint",
      "entities": ["结算", "提现"],
      "fields": ["withdrawable_amount"],
      "source": {"doc": "测试需求文档.md", "version": "V1.0", "section": "6.2.3-3", "kind": "explicit"},
      "authority": "A",
      "impact": "P0-阻断",
      "priority": "P0",
      "reasoning": "可提现金额计算，直接涉及资金安全，属资损防控核心约束"
    },
    {
      "id": "BR-25",
      "text": "金额以「分」为最小单位存储计算（整数或 Decimal），禁止浮点",
      "type": "field_constraint",
      "entities": ["结算"],
      "fields": ["amount"],
      "source": {"doc": "测试需求文档.md", "version": "V1.0", "section": "6.2.3-3", "kind": "explicit"},
      "authority": "A",
      "impact": "P0-阻断",
      "priority": "P0",
      "reasoning": "禁止浮点计算金额，属资损防控的精度硬约束"
    },
    {
      "id": "BR-26",
      "text": "可提现<0、可提现>累计收益、单合伙人金额日环比波动>50%、首页金额与台账对账差异>0.01元，四类命中任一即告警并携带 partner_id 与上下文",
      "type": "process",
      "entities": ["结算"],
      "fields": ["withdrawable_amount", "partner_commission"],
      "source": {"doc": "测试需求文档.md", "version": "V1.0", "section": "6.2.3-3", "kind": "explicit"},
      "authority": "A",
      "impact": "P0-阻断",
      "priority": "P0",
      "reasoning": "四类资损异常告警阈值，属对账/资损防控硬约束"
    },
    {
      "id": "BR-27",
      "text": "金额≥1亿时卡片展示「¥1.23 亿」，精确值进明细页看",
      "type": "field_constraint",
      "entities": ["结算"],
      "fields": ["amount"],
      "source": {"doc": "测试需求文档.md", "version": "V1.0", "section": "6.2.3-3", "kind": "explicit"},
      "authority": "A",
      "impact": "P3-边缘",
      "priority": "P3"
    },
    {
      "id": "BR-28",
      "text": "距下一档=下一档 min_orders − 当月签单数；已达最高档展示「已达最高档（45%）」",
      "type": "field_constraint",
      "entities": ["档位"],
      "fields": ["commission_tier"],
      "source": {"doc": "测试需求文档.md", "version": "V1.0", "section": "6.2.3-4", "kind": "explicit"},
      "authority": "A",
      "impact": "P1-功能",
      "priority": "P1"
    },
    {
      "id": "BR-29",
      "text": "档位按月独立计算，每月 1 日 00:00:00 起按新自然月重算（读时计算）；档位仅影响当月新签约订单，已生成/已结算的分成不追溯修改",
      "type": "process",
      "entities": ["档位"],
      "fields": ["commission_tier"],
      "source": {"doc": "测试需求文档.md", "version": "V1.0", "section": "6.2.3-4", "kind": "explicit"},
      "authority": "A",
      "impact": "P0-阻断",
      "priority": "P0",
      "reasoning": "档位不追溯历史结算，涉及分成口径一致性，属资金相关硬约束"
    },
    {
      "id": "BR-30",
      "text": "三类待办：待跟进线索（assigned/following）、待安排面试（interview_status=pending_schedule）、待签约订单（order_status=pending_sign）",
      "type": "process",
      "entities": ["线索", "面试", "订单"],
      "fields": ["status", "interview_status", "order_status"],
      "source": {"doc": "测试需求文档.md", "version": "V1.0", "section": "6.2.3-5", "kind": "explicit"},
      "authority": "A",
      "impact": "P1-功能",
      "priority": "P1"
    },
    {
      "id": "BR-31",
      "text": "快捷入口四个：领线索(P-08)/找阿姨(P-11)/发起面试(P-18)/创建签约(P-21)，入口可见性受功能开关控制；开关读取失败按隐藏处理",
      "type": "process",
      "entities": ["入口"],
      "fields": ["feature_flag"],
      "source": {"doc": "测试需求文档.md", "version": "V1.0", "section": "6.2.3-6", "kind": "explicit"},
      "authority": "A",
      "impact": "P2-体验",
      "priority": "P2"
    },
    {
      "id": "BR-32",
      "text": "所有接口从登录态解析 partner_id，禁止接受前端传入的 ID；非 approved 状态调用首页接口返回 403 且响应体不含任何金额字段",
      "type": "permission",
      "entities": ["合伙人"],
      "fields": ["partner_id", "audit_status"],
      "source": {"doc": "测试需求文档.md", "version": "V1.0", "section": "6.2.3-7", "kind": "explicit"},
      "authority": "A",
      "impact": "P0-阻断",
      "priority": "P0",
      "reasoning": "越权防护与状态守卫，涉及权限与数据安全，属硬约束"
    },
    {
      "id": "BR-33",
      "text": "首页聚合接口 P95≤500ms、P99≤800ms；p-home 首屏可交互 P95≤1.5s；p-register 首屏 P95≤1.2s",
      "type": "performance",
      "entities": ["首页", "注册"],
      "fields": ["p95_latency", "p99_latency"],
      "source": {"doc": "测试需求文档.md", "version": "V1.0", "section": "7.1", "kind": "explicit"},
      "authority": "A",
      "impact": "P1-功能",
      "priority": "P1"
    },
    {
      "id": "BR-34",
      "text": "全站 HTTPS（TLS≥1.2）；手机号/身份证号加密存储（AES-256-GCM 或国密 SM4），密钥 KMS 托管与业务库分离",
      "type": "permission",
      "entities": ["合伙人"],
      "fields": ["mobile", "id_card"],
      "source": {"doc": "测试需求文档.md", "version": "V1.0", "section": "7.1", "kind": "explicit"},
      "authority": "A",
      "impact": "P0-阻断",
      "priority": "P0",
