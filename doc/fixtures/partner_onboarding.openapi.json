{
  "openapi": "3.0.3",
  "info": {
    "title": "合伙人入驻（合成 fixture，非真实契约）",
    "version": "0.0.0-fixture",
    "description": "仅用于验证 AstSight A4 用例设计机制。字段取自 doc/测试需求文档.md 的表述，不代表真实接口契约；不得作为联调或验收依据。"
  },
  "servers": [
    {
      "url": "https://fixture.invalid"
    }
  ],
  "tags": [
    {
      "name": "fixture",
      "description": "synthetic"
    }
  ],
  "paths": {
    "/api/partner/sms/send": {
      "post": {
        "tags": ["fixture"],
        "operationId": "sendPartnerSmsCode",
        "summary": "发送注册短信验证码（合成）",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["mobile"],
                "properties": {
                  "mobile": {
                    "type": "string",
                    "pattern": "^1[3-9]\\d{9}$",
                    "description": "11 位手机号"
                  },
                  "captcha_token": {
                    "type": "string",
                    "description": "图形验证码通过后的 token；触发风控时必填"
                  },
                  "scene": {
                    "type": "string",
                    "enum": ["register"],
                    "default": "register"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "发送成功或命中频控",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "cooldown_seconds": {
                      "type": "integer",
                      "minimum": 0,
                      "description": "距离下次可发送的秒数"
                    },
                    "remaining_today": {
                      "type": "integer",
                      "minimum": 0,
                      "description": "当日剩余可发送次数"
                    },
                    "captcha_required": {
                      "type": "boolean",
                      "description": "后续是否要求图形验证码"
                    }
                  }
                }
              }
            }
          },
          "429": {
            "description": "发送过于频繁",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error_code": {"type": "string"},
                    "message": {"type": "string"}
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/partner/register": {
      "post": {
        "tags": ["fixture"],
        "operationId": "registerPartner",
        "summary": "提交合伙人注册（合成）",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "mobile",
                  "sms_code",
                  "city",
                  "id_card",
                  "agreement_checked",
                  "agreement_version",
                  "idempotency_key"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 20,
                    "description": "真实姓名，2–20 个字符"
                  },
                  "mobile": {
                    "type": "string",
                    "pattern": "^1[3-9]\\d{9}$",
                    "description": "11 位手机号"
                  },
                  "sms_code": {
                    "type": "string",
                    "pattern": "^\\d{6}$",
                    "description": "6 位数字短信验证码"
                  },
                  "city": {
                    "type": "string",
                    "enum": ["贵阳", "成都", "长沙", "武汉", "南京"],
                    "description": "城市枚举以接口返回的可选城市为准"
                  },
                  "id_card": {
                    "type": "string",
                    "minLength": 18,
                    "maxLength": 18,
                    "description": "18 位身份证号"
                  },
                  "agreement_checked": {
                    "type": "boolean",
                    "description": "协议勾选状态，默认未勾选"
                  },
                  "agreement_version": {
                    "type": "string",
                    "description": "用户勾选时展示的协议版本"
                  },
                  "idempotency_key": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64,
                    "description": "注册提交幂等键"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "注册成功，进入审核",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "partner_id": {"type": "string"},
                    "status": {"type": "string"},
                    "audit_status": {
                      "type": "string",
                      "enum": ["pending", "auditing", "approved", "rejected"]
                    },
                    "audit_step": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 4
                    },
                    "submit_at": {"type": "string", "format": "date-time"}
                  }
                }
              }
            }
          },
          "400": {
            "description": "字段校验失败",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error_code": {"type": "string"},
                    "message": {"type": "string"}
                  }
                }
              }
            }
          },
          "409": {
            "description": "重复提交",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error_code": {"type": "string"},
                    "message": {"type": "string"}
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/partner/audit-status": {
      "get": {
        "tags": ["fixture"],
        "operationId": "getPartnerAuditStatus",
        "summary": "查询审核状态（合成）",
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "required": true,
            "schema": {"type": "string"}
          }
        ],
        "responses": {
          "200": {
            "description": "审核状态",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "partner_id": {"type": "string"},
                    "audit_status": {
                      "type": "string",
                      "enum": ["pending", "auditing", "approved", "rejected"]
                    },
                    "audit_step": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 4
                    },
                    "status_label": {
                      "type": "string",
                      "description": "页面展示文案，例如审核中"
                    },
                    "submit_at": {"type": "string", "format": "date-time"},
                    "estimated_at": {
                      "type": "string",
                      "format": "date-time",
                      "description": "预计审核完成时间"
                    },
                    "approved_at": {"type": "string", "format": "date-time"},
                    "reject_reason": {"type": "string"},
                    "resubmit_count": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 3
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "无权限查看",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error_code": {"type": "string"},
                    "message": {"type": "string"}
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/partner/audit/resubmit": {
      "post": {
        "tags": ["fixture"],
        "operationId": "resubmitPartnerAudit",
        "summary": "驳回后重新提交审核（合成）",
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "required": true,
            "schema": {"type": "string"}
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "partner_id",
                  "name",
                  "city",
                  "id_card",
                  "agreement_checked",
                  "agreement_version"
                ],
                "properties": {
                  "partner_id": {"type": "string"},
                  "name": {"type": "string", "minLength": 2, "maxLength": 20},
                  "city": {
                    "type": "string",
                    "enum": ["贵阳", "成都", "长沙", "武汉", "南京"]
                  },
                  "id_card": {"type": "string", "minLength": 18, "maxLength": 18},
                  "agreement_checked": {"type": "boolean"},
                  "agreement_version": {"type": "string"}
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "重新提交成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "audit_status": {
                      "type": "string",
                      "enum": ["pending", "auditing", "approved", "rejected"]
                    },
                    "audit_step": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 4
                    },
                    "submit_at": {"type": "string", "format": "date-time"},
                    "resubmit_count": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 3
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "当前状态不允许重新提交",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error_code": {"type": "string"},
                    "message": {"type": "string"}
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/partner/dashboard": {
      "get": {
        "tags": ["fixture"],
        "operationId": "getPartnerDashboard",
        "summary": "合伙人首页工作台（合成）",
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "required": true,
            "schema": {"type": "string"}
          }
        ],
        "responses": {
          "200": {
            "description": "工作台数据",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "partner_name_masked": {
                      "type": "string",
                      "description": "脱敏后的合伙人姓名"
                    },
                    "tier": {
                      "type": "string",
                      "description": "当前等级标识"
                    },
                    "tier_label": {
                      "type": "string",
                      "description": "等级展示文案"
                    },
                    "monthly_order_count": {
                      "type": "integer",
                      "minimum": 0,
                      "description": "本月订单数"
                    },
                    "monthly_signed_amount": {
                      "type": "number",
                      "minimum": 0,
                      "description": "本月签约金额"
                    },
                    "cumulative_income": {
                      "type": "number",
                      "minimum": 0,
                      "description": "累计收益"
                    },
                    "withdrawable_amount": {
                      "type": "number",
                      "minimum": 0,
                      "description": "可提现金额，不超过累计收益"
                    },
                    "tier_progress": {
                      "type": "object",
                      "properties": {
                        "current_tier": {"type": "string"},
                        "next_tier": {"type": "string"},
                        "orders_needed": {
                          "type": "integer",
                          "minimum": 0
                        }
                      }
                    },
                    "todos": {
                      "type": "object",
                      "properties": {
                        "followup_count": {"type": "integer", "minimum": 0},
                        "interview_count": {"type": "integer", "minimum": 0},
                        "contract_count": {"type": "integer", "minimum": 0}
                      }
                    },
                    "entries": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "entry_id": {"type": "string"},
                          "title": {"type": "string"},
                          "enabled": {"type": "boolean"}
                        }
                      }
                    },
                    "updated_at": {"type": "string", "format": "date-time"}
                  }
                }
              }
            }
          },
          "403": {
            "description": "无权限访问工作台",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error_code": {"type": "string"},
                    "message": {"type": "string"}
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {}
  },
  "x-astsight-fixture": {
    "purpose": "A4 mechanics validation only",
