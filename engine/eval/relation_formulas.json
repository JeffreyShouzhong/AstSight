{
  "schema_version": 1,
  "name": "relation-formula-extraction",
  "description": "A1 从中文需求原文抽取显式公式关系的离线评估集；expected 只记录目标字段/关系运算/表达式运算集合，不绑定具体 AST 形态。",
  "cases": [
    {
      "id": "sum_pluck_total",
      "requirement": "创建订单成功后，响应中的 total 必须等于 items 中每个元素的 price 之和。",
      "expected": [
        {
          "assertion_kind": "body_field",
          "target": "total",
          "op": "eq",
          "ops": [
            "sum",
            "pluck"
          ],
          "sources": [
            "response"
          ],
          "paths": [
            "response:items"
          ]
        }
      ]
    },
    {
      "id": "avg_pluck_score",
      "requirement": "查询评审列表时，响应中的 average_score 必须等于 reviews 中每条记录 score 的平均值。",
      "expected": [
        {
          "assertion_kind": "body_field",
          "target": "average_score",
          "op": "eq",
          "ops": [
            "avg",
            "pluck"
          ],
          "sources": [
            "response"
          ],
          "paths": [
            "response:reviews"
          ]
        }
      ]
    },
    {
      "id": "max_pluck_price",
      "requirement": "响应中的 highest_price 必须等于 items 中 price 的最大值。",
      "expected": [
        {
          "assertion_kind": "body_field",
          "target": "highest_price",
          "op": "eq",
          "ops": [
            "max",
            "pluck"
          ],
          "sources": [
            "response"
          ],
          "paths": [
            "response:items"
          ]
        }
      ]
    },
    {
      "id": "distinct_sku_count",
      "requirement": "响应中的 distinct_sku_count 必须等于 items 中 sku 去重后的数量。",
      "expected": [
        {
          "assertion_kind": "body_field",
          "target": "distinct_sku_count",
          "op": "eq",
          "ops": [
            "count_distinct",
            "pluck"
          ],
          "sources": [
            "response"
          ],
          "paths": [
            "response:items"
          ]
        }
      ]
    },
    {
      "id": "len_items",
      "requirement": "响应中的 item_count 必须等于 items 的数量。",
      "expected": [
        {
          "assertion_kind": "body_field",
          "target": "item_count",
          "op": "eq",
          "ops": [
            "len"
          ],
          "sources": [
            "response"
          ],
          "paths": [
            "response:items"
          ]
        }
      ]
    },
    {
      "id": "div_unit_price",
      "requirement": "响应中的 unit_price 必须等于 total 除以 quantity 的结果。",
      "expected": [
        {
          "assertion_kind": "body_field",
          "target": "unit_price",
          "op": "eq",
          "ops": [
            "div"
          ],
          "sources": [
            "response"
          ],
          "paths": [
            "response:quantity",
            "response:total"
          ]
        }
      ]
    },
    {
      "id": "echo_request_order_id",
      "requirement": "查询订单时，响应中的 order_id 必须与本次请求里的 order_id 一致。",
      "expected": [
        {
          "assertion_kind": "body_field",
          "target": "order_id",
          "op": "eq",
          "ops": [],
          "sources": [
            "request"
          ],
          "paths": [
            "request:order_id"
          ]
        }
      ]
    },
    {
      "id": "cross_step_order_id",
      "requirement": "查询订单返回的 order_id 必须与创建订单时返回的 order_id 一致。",
      "expected": [
        {
          "assertion_kind": "body_field",
          "target": "order_id",
          "op": "eq",
          "ops": [],
          "sources": [
            "step"
          ],
          "paths": [
            "step:order_id"
          ]
        }
      ]
    },
    {
      "id": "descriptive_no_formula",
      "requirement": "系统会记录订单的创建时间和最后更新时间，并在日志中保留操作人。",
      "expected": []
    },
    {
      "id": "vague_no_formula",
      "requirement": "订单总额与订单明细存在关联，具体计算方式由业务方后续补充。",
      "expected": []
    },
    {
      "id": "previous_request_unsupported",
      "requirement": "查询订单时，响应中的 order_id 必须与创建请求里的 order_id 一致。",
      "expected": [],
      "note": "当前表达式没有‘上一个动作的请求字段’节点，应写 gap 而不是用 $step 冒充"
    },
    {
      "id": "conditional_coupon_sub",
      "requirement": "使用优惠券时，响应中的 pay_amount 必须等于 total 减去 discount；未使用优惠券时 discount 为 0。",
      "expected": [
        {
          "assertion_kind": "body_field",
          "target": "pay_amount",
          "op": "eq",
          "ops": [
            "sub"
          ],
          "sources": [
            "response"
          ],
          "paths": [
            "response:discount",
            "response:total"
          ]
        }
      ]
    },
    {
      "id": "percentage_commission",
      "requirement": "响应中的 commission 必须等于 total 乘以 rate 再除以 100。",
      "expected": [
        {
          "assertion_kind": "body_field",
          "target": "commission",
          "op": "eq",
          "ops": [
            "mul",
            "div"
          ],
          "sources": [
            "response"
          ],
          "paths": [
            "response:rate",
            "response:total"
          ]
        }
      ]
    },
    {
      "id": "mixed_arithmetic_net",
      "requirement": "响应中的 net_amount 必须等于 price 乘以 quantity 再减去 discount。",
      "expected": [
        {
          "assertion_kind": "body_field",
          "target": "net_amount",
          "op": "eq",
          "ops": [
            "mul",
            "sub"
          ],
          "sources": [
            "response"
          ],
          "paths": [
            "response:discount",
            "response:price",
            "response:quantity"
          ]
        }
      ]
    },
    {
      "id": "step_minus_request",
      "requirement": "查询订单时，响应中的 total 必须等于创建订单时返回的 total 减去本次请求里的 discount。",
      "expected": [
        {
          "assertion_kind": "body_field",
          "target": "total",
          "op": "eq",
          "ops": [
            "sub"
          ],
          "sources": [
            "request",
            "step"
          ],
          "paths": [
            "request:discount",
            "step:total"
          ]
        }
      ]
    },
    {
      "id": "request_times_price",
      "requirement": "创建订单的响应中，total 必须等于本次请求里的 quantity 乘以 price。",
      "expected": [
        {
          "assertion_kind": "body_field",
          "target": "total",
          "op": "eq",
          "ops": [
            "mul"
          ],
          "sources": [
            "request"
          ],
          "paths": [
            "request:price",
            "request:quantity"
          ]
        }
      ]
    },
    {
      "id": "sum_two_lists",
      "requirement": "响应中的 total 必须等于 items 中 price 之和加上 items 中 tax 之和。",
      "expected": [
        {
          "assertion_kind": "body_field",
          "target": "total",
          "op": "eq",
          "ops": [
            "add",
            "sum",
            "pluck"
          ],
          "sources": [
            "response"
          ],
          "paths": [
            "response:items"
          ]
        }
      ]
    },
    {
      "id": "vip_discount_unmapped",
      "requirement": "如果用户是 VIP，则订单打九折。",
      "expected": []
    },
    {
      "id": "shipping_by_region",
      "requirement": "运费根据收货地区不同而不同。",
      "expected": []
    },
    {
      "id": "threshold_discount_no_fields",
      "requirement": "满 100 元减 20 元。",
      "expected": []
    }
  ]
}
