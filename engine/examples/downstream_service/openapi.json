{
  "openapi": "3.0.3",
  "info": {
    "title": "AstSight Quote Service",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {"description": "Successful Response"}
        }
      }
    },
    "/api/v1/quotes": {
      "post": {
        "operationId": "create_quote_api_v1_quotes_post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["sku", "quantity"],
                "properties": {
                  "sku": {"type": "string", "minLength": 3, "maxLength": 40},
                  "quantity": {"type": "integer", "minimum": 1, "maximum": 99}
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "sku": {"type": "string"},
                    "quantity": {"type": "integer"},
                    "total_cents": {"type": "integer"}
                  }
                }
              }
            }
          },
          "404": {"description": "sku not found"},
          "422": {"description": "Validation Error"}
        }
      }
    }
  }
}
